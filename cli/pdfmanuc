#!/usr/bin/env bash
#
# pdfmanuc - pdf manuscript compressor
#
# Сжимает pdf-документы рукописных лекций (черно-белые изображения с большой
# долей белого фона) путем конвертации: pdf -> монохромные pbm -> постраничные
# pdf -> сборка в единый pdf-файл.

set -euo pipefail

PROG="pdfmanuc"
DEFAULT_DEVICE="tablet"

# Печать справки по использованию
usage() {
    cat <<EOF
Использование: ${PROG} [опции] <входной.pdf>

Сжимает pdf-документ рукописных лекций.

Опции:
    -h, --help          показать эту справку и выйти
    -o <файл>           файл для записи результата
                        (по умолчанию <входной>.manuc.pdf рядом с исходным)
    --for-device <устройство>
                        профиль сжатия: eink (150 dpi, монохром),
                        tablet (300 dpi, монохром), print (300 dpi, градации
                        серого); по умолчанию ${DEFAULT_DEVICE}
    -r <разрешение>     целевое разрешение изображений в DPI; переопределяет
                        разрешение выбранного профиля

Примеры:
    ${PROG} core.pdf
    ${PROG} --for-device eink core.pdf
    ${PROG} --for-device print -o out.pdf core.pdf
    ${PROG} --for-device tablet -r 600 core.pdf
EOF
}

# Разрешение профиля устройства по умолчанию
device_resolution() {
    case "$1" in
        eink)   echo "150" ;;
        tablet) echo "300" ;;
        print)  echo "300" ;;
        *)      return 1 ;;
    esac
}

# Флаг цветового режима pdftoppm для профиля устройства
device_mode() {
    case "$1" in
        eink|tablet) echo "-mono" ;;
        print)       echo "-gray" ;;
        *)           return 1 ;;
    esac
}

# Печать короткой справки по установке зависимостей.
# Текст согласован с разделом "Installation" корневого README.md.
install_help() {
    cat <<'EOF'
Установите необходимые утилиты (pdftoppm, img2pdf, pdftk).

Ubuntu / Debian:
    sudo apt update && sudo apt install -y poppler-utils img2pdf pdftk-java

Red Hat / Fedora:
    sudo dnf install -y poppler-utils img2pdf pdftk

Arch Linux:
    sudo pacman -S --needed poppler img2pdf pdftk
EOF
}

# Вывод сообщения об ошибке и завершение с ненулевым кодом
die() {
    echo "Ошибка: $*" >&2
    exit 1
}

# Проверка наличия необходимого ПО; при отсутствии печатает справку по установке
check_dependencies() {
    local missing=()
    local tool
    for tool in pdftoppm img2pdf pdftk; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing+=("$tool")
        fi
    done

    if [ "${#missing[@]}" -gt 0 ]; then
        echo "Ошибка: не найдены необходимые утилиты: ${missing[*]}" >&2
        echo >&2
        install_help >&2
        exit 1
    fi
}

# Разбор аргументов командной строки
output=""
device="$DEFAULT_DEVICE"
resolution=""
resolution_set=0
input=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -o)
            [ "$#" -ge 2 ] || die "для опции -o требуется значение"
            output="$2"
            shift 2
            ;;
        --for-device)
            [ "$#" -ge 2 ] || die "для опции --for-device требуется значение"
            device="$2"
            shift 2
            ;;
        -r)
            [ "$#" -ge 2 ] || die "для опции -r требуется значение"
            resolution="$2"
            resolution_set=1
            shift 2
            ;;
        -*)
            die "неизвестный аргумент: $1"
            ;;
        *)
            [ -z "$input" ] || die "лишний аргумент: $1"
            input="$1"
            shift
            ;;
    esac
done

# Проверка обязательных условий
[ -n "$input" ] || die "не указан входной файл. Используйте -h для справки."
[ -f "$input" ] || die "входной файл не найден: $input"
[ -r "$input" ] || die "входной файл недоступен для чтения: $input"

# Проверка профиля устройства
case "$device" in
    eink|tablet|print) ;;
    *) die "недопустимый профиль устройства: $device (доступны: eink, tablet, print)" ;;
esac

# Разрешение: профиль задаёт значение по умолчанию, явный -r его переопределяет
if [ "$resolution_set" -eq 0 ]; then
    resolution="$(device_resolution "$device")"
fi

# Цветовой режим определяется профилем устройства
mode="$(device_mode "$device")"

# Расширение файлов страниц зависит от режима pdftoppm:
# монохром (-mono) даёт .pbm, градации серого (-gray) дают .pgm
case "$mode" in
    -mono) page_ext="pbm" ;;
    -gray) page_ext="pgm" ;;
esac

case "$resolution" in
    ''|*[!0-9]*) die "разрешение должно быть целым положительным числом: $resolution" ;;
esac
[ "$resolution" -gt 0 ] || die "разрешение должно быть больше нуля: $resolution"

# Выходной файл по умолчанию: <входной>.manuc.pdf рядом с исходным
if [ -z "$output" ]; then
    output="${input%.pdf}.manuc.pdf"
fi

check_dependencies

# Временный каталог для промежуточных файлов, удаляется при любом завершении
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

echo "Конвертация pdf в страницы (профиль ${device}, разрешение ${resolution} dpi, режим ${mode})..."
pdftoppm -r "$resolution" "$mode" "$input" "$tmpdir/page"

shopt -s nullglob
pages=("$tmpdir"/page-*."$page_ext")
shopt -u nullglob
[ "${#pages[@]}" -gt 0 ] || die "не удалось получить страницы из файла: $input"

echo "Конвертация страниц в постраничные pdf..."
pdfs=()
for page in "${pages[@]}"; do
    pdf="${page%.*}.pdf"
    img2pdf "$page" -o "$pdf"
    pdfs+=("$pdf")
done

echo "Сборка результата: ${output}"
pdftk "${pdfs[@]}" cat output "$output"

echo "Готово: ${output}"
